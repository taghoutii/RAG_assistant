# Copy to .env (which is gitignored) and fill in your own keys:
#   Copy-Item .env.example .env
# Never commit .env. Free tiers only: no payment method is needed for any of these.

# Generator (openai/gpt-oss-120b) and fallback judge (qwen/qwen3.8-27b), Groq free tier.
# Llama models left Groq's free tier on 2026-08-16. https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Judge (Gemini 3.5 Flash-Lite, Google AI Studio free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Offline fallback (no key needed). Default local Ollama address.
OLLAMA_HOST=http://localhost:11434
