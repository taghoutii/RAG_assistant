# Copy to .env (which is gitignored) and fill in your own keys:
#   Copy-Item .env.example .env
# Never commit .env. Free tiers only: no payment method is needed for any of these.

# Generator (Groq free tier, Llama models): https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Judge (Google AI Studio free tier, Gemini Flash / Flash-Lite): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Offline fallback (no key needed). Default local Ollama address.
OLLAMA_HOST=http://localhost:11434
